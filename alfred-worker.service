# Worker nodes (Zenbook, MacBook, Pi...): the machine offers its hands at boot.
[Unit]
Description=Alfred worker node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/Alfred
# --bus auto: finds the desktop by its LAN beacon. Pin it instead with
# --bus nats://DESKTOP-IP:4222 if broadcast is blocked on your network.
ExecStart=/usr/bin/python3 /home/%i/Alfred/run_node.py --bus auto
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
